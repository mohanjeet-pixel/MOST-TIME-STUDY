# Copy to .env and fill in
GEMINI_API_KEY=your-gemini-api-key-here

# gemini-2.5-flash = better step counting; gemini-2.5-flash-lite = cheapest
GEMINI_MODEL=gemini-2.5-flash

# Seconds per MOST index unit. BasicMOST data card: 1 index = 10 TMU = 0.36 s (old CS PRE BENDING sheet used 1.2 = 3.3x too high)
SECONDS_PER_INDEX=0.36

# How to treat a step range like "5-8 steps": min | max | avg  (your sheet uses min)
STEP_RANGE_POLICY=min

# Code shown for process/treatment time rows (your sheet uses M; standard MOST uses X)
PROCESS_CODE=M

# Default value for OPRT column
DEFAULT_OPRT=3

# ---- Cost control ----
USD_INR=88
# AI hidden reasoning tokens (billed as output). 0 = cheapest, 1024 = balanced, -1 = unlimited
THINKING_BUDGET=1024
# Max frames/second the AI looks at, and max frames per video
MAX_FPS=3
FRAME_BUDGET=600

# Report: standard time = MOST time x (1 + allowance %); output per shift uses SHIFT_MIN
ALLOWANCE_PCT=15
SHIFT_MIN=480
